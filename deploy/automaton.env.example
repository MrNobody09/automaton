# Optional runtime overrides for /etc/automaton/automaton.env
# Keep this file root-readable only in production (chmod 600).

# CONWAY_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=
# CONWAY_API_URL=https://api.conway.tech
# AUTOMATON_STATE_DIR=/root/.automaton
# AUTOMATON_BACKUP_DIR=/var/backups/automaton

# Owner Control Plane (token must be at least 32 characters)
# OWNER_CONTROL_TOKEN=
# OWNER_CONTROL_HOST=127.0.0.1
# OWNER_CONTROL_PORT=8787
