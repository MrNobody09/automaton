{
  "name": "@conway/automaton",
  "version": "0.2.1",
  "description": "Conway Automaton - Sovereign AI Agent Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "conway-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Conway-Research/automaton.git"
  },
  "homepage": "https://conway.tech",
  "keywords": ["autonomous-agent", "sovereign-ai", "web4", "conway", "self-replicating"],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && pnpm -r build",
    "dev": "tsx watch src/index.ts",
    "test": "tsx scripts/run-isolated-tests.ts",
    "test:ci": "tsx scripts/run-isolated-tests.ts",
    "test:isolated": "tsx scripts/run-isolated-tests.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "validation:contract": "tsx scripts/verify-validation-contract.ts",
    "validation:artifacts": "tsx scripts/verify-package-artifacts.ts",
    "business:register": "tsx scripts/register-business-tools.ts",
    "production:health": "node dist/production/health-cli.js",
    "production:backup": "node dist/production/backup-cli.js",
    "production:install": "bash scripts/install-production.sh",
    "clean": "rm -rf dist && pnpm -r clean"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.24.0",
    "ora": "^8.0.0",
    "simple-git": "^3.36.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "siwe": "^2.3.0",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "engines": { "node": ">=20.0.0" },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"],
    "overrides": {
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vite@<=6.4.2": "6.4.3",
      "postcss@<=8.5.17": "8.5.18",
      "nanoid@<3.3.18": "3.3.18",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11"
    }
  }
}
